PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=admin_gym_management
JWT_SECRET=gym_super_secret_key_change_me
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Razorpay TEST keys — Dashboard → switch to Test Mode → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# dummy = built-in demo payment gateway (no real money). Remove or set to razorpay once test keys are added.
PAYMENT_MODE=dummy

# Email (SMTP). Gmail: host smtp.gmail.com, port 587, user = your Gmail, pass = an App Password
# Leave SMTP_HOST empty to only log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GymPro <no-reply@gympro.in>"
# Booking notifications for the office (falls back to the email in Admin → Gym Details)
OFFICE_EMAIL=
