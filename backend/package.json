{
  "name": "gym-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "sql": "node scripts/run-sql.js",
    "build:web": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "serve": "npm run build:web && node src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.0",
    "nodemailer": "^10.0.12",
    "socket.io": "^4.6.2"
  }
}
